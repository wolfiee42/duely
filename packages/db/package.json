{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "db": "varlock run --path ../../apps/app -- drizzle-kit",
    "auth:generate": "varlock run --path ../../apps/app -- vpx auth@latest generate --config ../auth/src/cli.ts --y --output ./src/schema/auth.schema.ts",
    "e2e:prepare": "node --experimental-strip-types scripts/prepare-e2e.ts"
  },
  "dependencies": {
    "@repo/domain": "workspace:*",
    "drizzle-orm": "catalog:",
    "nanoid": "catalog:",
    "postgres": "catalog:",
    "varlock": "catalog:"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:"
  }
}
