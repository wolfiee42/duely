{
  "name": "cove-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp run --recursive build",
    "build:app": "vp run --filter=@repo/app build",
    "dev": "vp run --recursive --parallel dev",
    "dev:app": "vp run --filter=@repo/app dev",
    "lint": "vp lint --type-aware --type-check",
    "lint:fix": "vp lint --type-aware --type-check --fix",
    "test": "vp test",
    "test:e2e": "vp run --recursive test:e2e",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "eval:classify": "varlock run --path apps/app -- cross-env EVAL_LIVE=1 vp test packages/api/src/eval/classify-eval.test.ts",
    "env:audit": "cd apps/app && varlock audit . ../../packages/auth ../../packages/db",
    "env:load": "varlock load --path apps/app",
    "env:codegen": "varlock codegen --path apps/app",
    "prepare": "vp config && vp run env:codegen && vp run cf-typegen",
    "deps": "vpx taze@latest -Ilwr --maturity-period 3",
    "fallow": "vpx fallow@latest --skip health",
    "tanstack": "vpx @tanstack/cli@latest",
    "db": "vp run --filter=@repo/db db",
    "ui": "vp run --filter=@repo/ui ui",
    "ui:app": "vp run --filter=@repo/app ui",
    "auth:secret": "vpx auth@latest secret",
    "auth:generate": "vp run --filter=@repo/db auth:generate",
    "skills": "vpx skills@latest",
    "intent": "vpx @tanstack/intent@latest",
    "cf-typegen": "vp run --recursive cf-typegen"
  },
  "devDependencies": {
    "@tanstack/eslint-plugin-query": "catalog:",
    "@tanstack/eslint-plugin-router": "catalog:",
    "varlock": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.15.0",
  "generator": "create-cove",
  "intent": {
    "skills": [
      "@tanstack/*"
    ]
  }
}
