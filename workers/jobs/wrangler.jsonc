{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "duely-jobs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *"] },
  // D4: the jobs worker uses the system role, then drops into one tenant per unit of work.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE_SYSTEM",
      "id": "00000000000000000000000000000002",
      "localConnectionString": "postgresql://duely_system:duely_system@localhost:5432/duely",
    },
  ],
  "queues": {
    "producers": [{ "binding": "QUEUE_MAIN", "queue": "duely-main" }],
    "consumers": [
      {
        "queue": "duely-main",
        "max_batch_size": 10,
        "max_retries": 5,
        "dead_letter_queue": "duely-dead",
      },
    ],
  },
  "vars": {
    "PLATFORM_DOMAIN": "duely.app",
    "APP_ORIGIN": "https://app.duely.app",
    "EMAIL_FROM_ADDRESS": "billing@duely.app",
    "CLOUDFLARE_ZONE_ID": "00000000000000000000000000000000",
  },
  // Secrets: RESEND_API_KEY, CLOUDFLARE_API_TOKEN (`wrangler secret put <NAME>`).
}
