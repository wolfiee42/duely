# This env file uses @env-spec: https://varlock.dev/env-spec
#
# @defaultRequired=false @defaultSensitive=false
# @generateTsTypes(path=env.d.ts)
# ----------

# Public origin of the app host (staff UI and /api/auth). Used by the browser and Better Auth.
# @required @type=url
VITE_BASE_URL=http://app.localhost:3000

# Platform root domain (SPEC D20). `app.<domain>` is the staff app, `<slug>.<domain>` a client portal.
# Locally `*.localhost` resolves to this machine, so `acme.localhost:3000` works without hosts entries.
# @required
PLATFORM_DOMAIN=localhost

# Migration owner connection, for drizzle-kit and tests only. The Worker reaches Postgres through the
# Hyperdrive bindings (wrangler.jsonc), never through this URL. Run `docker-compose up -d` first.
# @required @sensitive @type=url(allowedProtocols=postgresql)
DATABASE_URL=postgresql://duely_owner:duely_owner@localhost:5432/duely

# Better Auth signing secret. Generate one with `vpr auth:secret`.
# @required @sensitive
# @docs(https://better-auth.com/docs/reference/environment-variables)
BETTER_AUTH_SECRET=

# `live` talks to Stripe, Resend, R2 and Queues. `fake` keeps everything in memory (local dev and E2E):
# no real email or payments, and the outbox is delivered inline. Refused unless PLATFORM_DOMAIN is `localhost`.
# @type=enum(live, fake)
SERVICES_MODE=live

# Stripe (SPEC 9.2). Test-mode keys only for the demo.
# @sensitive
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# @sensitive
STRIPE_CONNECT_WEBHOOK_SECRET=

# Cloudflare for SaaS custom hostnames (SPEC 7.2). The token needs "SSL and Certificates: Edit" on the zone.
# @sensitive
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Fallback origin firms point their CNAME at, e.g. customers.duely.app. Defaults to customers.$PLATFORM_DOMAIN.
CLOUDFLARE_CNAME_TARGET=

# Claude, for invoice extraction, reply classification and drafts. Empty turns the AI features off.
# @sensitive
ANTHROPIC_API_KEY=
# Defaults to claude-haiku-5-5.
AI_MODEL=

# Resend, and the verified sender address for every outbound email.
# @sensitive
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=billing@duely.app
# Svix signing secret of the Resend webhook (delivery events), e.g. whsec_...
# @sensitive
RESEND_WEBHOOK_SECRET=

# Signs portal session state. Generate with `openssl rand -base64 32`.
# @sensitive
PORTAL_SESSION_SECRET=
