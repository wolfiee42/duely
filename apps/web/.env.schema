# This env file uses @env-spec: https://varlock.dev/env-spec
#
# @defaultRequired=false @defaultSensitive=false
# @generateTsTypes(path=env.d.ts)
# ----------

# Public origin of the app host (staff UI and /api/auth). Used by the browser and Better Auth.
# @required @type=url
VITE_BASE_URL=http://app.localhost:3000

# Platform root domain (SPEC D20). `app.<domain>` is the staff app, `<slug>.<domain>` a client portal.
# Locally `*.localhost` resolves to this machine, so `acme.localhost:3000` works without hosts entries.
# @required
PLATFORM_DOMAIN=localhost

# Migration owner connection, for drizzle-kit and tests only. The Worker reaches Postgres through the
# Hyperdrive bindings (wrangler.jsonc), never through this URL. Run `docker-compose up -d` first.
# @required @sensitive @type=url(allowedProtocols=postgresql)
DATABASE_URL=postgresql://duely_owner:duely_owner@localhost:5432/duely

# Better Auth signing secret. Generate one with `vpr auth:secret`.
# @required @sensitive
# @docs(https://better-auth.com/docs/reference/environment-variables)
BETTER_AUTH_SECRET=
